{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chud Input Recorder",
  "mainBinaryName": "chud-input-recorder",
  "version": "0.2.0",
  "identifier": "com.bigfatdeuce.chud-input-recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Chud Input Recorder",
        "width": 1480,
        "height": 920,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#011128"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Chud Input Recorder contributors",
    "homepage": "https://github.com/BigFatDeuce/Chud-Input-Recorder",
    "category": "Utility",
    "shortDescription": "Record, edit and replay keyboard, mouse and gamepad input",
    "longDescription": "Chud Input Recorder records keyboard, mouse and gamepad input with precise timing, lets you edit recordings on a timeline, and replays them with loops, conditions and automation blocks. Everything stays on your computer.",
    "copyright": "MIT License",
    "icon": [
      "../../assets/brand/chud-input-icon/png/icon-32.png",
      "../../assets/brand/chud-input-icon/png/icon-128.png",
      "../../assets/brand/chud-input-icon/png/icon-256.png",
      "../../assets/brand/chud-input-icon/png/icon-512.png",
      "../../assets/brand/chud-input-icon/icon.icns",
      "../../assets/brand/chud-input-icon/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMDg4NEU4NDREQjJFQ0MKUldUTUx0dEU2SVFJWDhNNnVDQy9sRXVtUUVIbVlHYm0yMlo3N1pQVWRGQnhWc0R0OC8yZ3FJckMK",
      "endpoints": ["https://github.com/BigFatDeuce/Chud-Input-Recorder/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
